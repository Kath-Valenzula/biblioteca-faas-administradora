flowchart TB
 subgraph AzureApps["Azure Container Apps"]
        BFF["BFF Spring Boot<br>bff-biblioteca-kath2026<br>orquestador REST<br>proxy GraphQL<br>productor Service Bus S5 legacy"]
        ServicioLibros["servicio-libros Spring Boot<br>servicio-libros-kath2026<br>REST + GraphQL<br>JPA / JDBC / ojdbc11"]
  end
 subgraph AzureFunctions["Azure Functions"]
        Usuarios["function-usuarios<br>biblio-usuarios-kath2026-v2<br>CRUD usuarios + GraphQL<br>DELETE cascade + evento S9"]
        Prestamos["function-prestamos<br>biblio-prestamos-kath2026-v2<br>CRUD préstamos + devoluciones + GraphQL"]
        FunctionLibros["function-libros<br>biblio-libros-kath2026<br>CRUD libros + GraphQL"]
        Notificaciones["function-notificaciones<br>biblio-notificaciones-kath2026<br>@ServiceBusQueueTrigger - S5<br>@EventGridTrigger - S8/S9<br>solo consume eventos/mensajes"]
  end
 subgraph EventGrid["Azure Event Grid"]
        EventGridTopic["Topic: biblioteca-eventos-topic<br>Publica:<br>Biblioteca.PrestamoCreado - S8<br>Biblioteca.PrestamoDevuelto - S8<br>Biblioteca.UsuarioEliminado - S9"]
        EventGridSub["Subscription: biblioteca-prestamos-notificaciones-sub<br>Filtros:<br>Biblioteca.PrestamoCreado<br>Biblioteca.PrestamoDevuelto<br>Biblioteca.UsuarioEliminado<br>Destino: function-notificaciones"]
  end
 subgraph ServiceBusBox["Azure Service Bus - S5 legacy"]
        ServiceBus["Namespace: servicebus-katherine2026<br>Cola: prestamo-notificaciones"]
  end
 subgraph OCI["Oracle - OCI"]
        Oracle["Oracle Autonomous Database<br>Persistencia única<br>Tablas: USUARIOS, LIBROS, PRESTAMOS"]
  end
    Cliente["Cliente REST / Swagger / Postman / curl"] -- HTTP REST / GraphQL proxy --> BFF
    BFF -- REST / GraphQL --> Usuarios & Prestamos & ServicioLibros
    BFF -- "POST /api/prestamos/notificar - S5 legacy" --> ServiceBus
    ServiceBus -- "@ServiceBusQueueTrigger - S5" --> Notificaciones
    Prestamos -- "publica PrestamoCreado / PrestamoDevuelto - S8" --> EventGridTopic
    Usuarios -- "DELETE cascade + publica UsuarioEliminado - S9" --> EventGridTopic
    EventGridTopic -- enruta evento --> EventGridSub
    EventGridSub -- "@EventGridTrigger" --> Notificaciones
    Usuarios -- JDBC / TLS --> Oracle
    Prestamos -- JDBC / TLS --> Oracle
    ServicioLibros -- JPA / JDBC / ojdbc11 --> Oracle
    FunctionLibros -- JDBC / TLS --> Oracle
    Observabilidad["Application Insights / Log Stream<br>correlationId<br>[NOTIFICACION SIMULADA]"]

